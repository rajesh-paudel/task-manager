{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'name', 'profileUrl']) && newData.child('uid').val() === $uid && newData.child('name').isString() && newData.child('profileUrl').isString()"
      }
    },
    "tasks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$taskId": {
          ".validate": "newData.hasChildren(['title', 'status', 'priority', 'createdAt'])"
        }
      }
    },
    "forms": {
      ".read": "auth != null",
      ".write": true,
      "$formId": {
        ".validate": "newData.hasChildren(['name', 'email', 'message', 'createdAt'])"
      }
    },
    "workspaces": {
      "$workspaceId": {
        ".read": "auth != null && root.child('workspaceMembers').child($workspaceId).child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('workspaceMembers').child($workspaceId).child(auth.uid).child('role').val() === 'owner' || root.child('workspaceMembers').child($workspaceId).child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "workspaceMembers": {
      "$workspaceId": {
        ".read": "auth != null && root.child('workspaceMembers').child($workspaceId).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && ($uid === auth.uid || root.child('workspaceMembers').child($workspaceId).child(auth.uid).child('role').val() === 'owner' || root.child('workspaceMembers').child($workspaceId).child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "userWorkspaces": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$workspaceId": {
          ".write": "auth != null && ($uid === auth.uid || root.child('workspaceMembers').child($workspaceId).child(auth.uid).child('role').val() === 'owner' || root.child('workspaceMembers').child($workspaceId).child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "workspaceTasks": {
      "$workspaceId": {
        ".read": "auth != null && root.child('workspaceMembers').child($workspaceId).child(auth.uid).exists()",
        ".write": "auth != null && root.child('workspaceMembers').child($workspaceId).child(auth.uid).exists()",
        "$taskId": {
          ".validate": "newData.hasChildren(['title', 'status', 'priority', 'createdAt'])"
        }
      }
    }
  }
}
